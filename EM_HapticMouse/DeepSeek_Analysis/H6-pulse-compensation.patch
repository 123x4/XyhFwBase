-#define H6_PULSE_TRIM_COUNTS    (-33)
+#define H6_PULSE_TRIM_COUNTS    (-41)   /* 0.854 us below nominal, see H6_COMP */
+
+/* Fine compensation after the timer deadline. Keep this a literal sequence:
+ * one __NOP() is one 48 MHz cycle, so 18 NOPs are 375 ns. To calibrate, add
+ * or remove whole NOPs on the H6_COMP() line and re-measure. */
+#define H6_COMP_1()    __NOP()
+#define H6_COMP_2()    H6_COMP_1(); H6_COMP_1()
+#define H6_COMP_4()    H6_COMP_2(); H6_COMP_2()
+#define H6_COMP_8()    H6_COMP_4(); H6_COMP_4()
+#define H6_COMP_16()   H6_COMP_8(); H6_COMP_8()
+#define H6_COMP()      H6_COMP_16(); H6_COMP_2()
 
